# Copy to `.env` (gitignored) and fill in locally. Never commit real values.

# LLM (used from Phase 3). Leave empty for Phase 1/2 — the data layer does not need it.
GEMINI_API_KEY=

# SQLite cache location (default: data/cache/cache.db)
WEATHER_RISK_CACHE_PATH=data/cache/cache.db

# Cache TTLs in seconds
WEATHER_RISK_TTL_HISTORICAL_SECONDS=2592000
WEATHER_RISK_TTL_RECENT_SECONDS=86400
WEATHER_RISK_TTL_NRI_SECONDS=604800

# HTTP
WEATHER_RISK_HTTP_TIMEOUT_SECONDS=30
WEATHER_RISK_HTTP_MAX_ATTEMPTS=3

LOG_LEVEL=INFO
