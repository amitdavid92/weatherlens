# Copy to `.env` (gitignored) and fill in locally. Never commit real values.

# LLM (Phase 3+). Put the real key ONLY in `.env` (gitignored). Never commit it.
GEMINI_API_KEY=
WEATHER_RISK_GEMINI_MODEL=gemini-3.5-flash-lite
WEATHER_RISK_GEMINI_FALLBACK_MODEL=gemini-3.6-flash,gemini-3.5-flash
WEATHER_RISK_LLM_THINKING_LEVEL=low
WEATHER_RISK_LLM_TIMEOUT_SECONDS=45
WEATHER_RISK_LLM_MAX_ATTEMPTS=3

# Conversation storage and local frontend origin(s)
WEATHER_RISK_SESSIONS_PATH=data/cache/sessions.db
WEATHER_RISK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# true = never call weather APIs (cache + committed snapshot only). Gemini still needs network.
WEATHER_RISK_OFFLINE=false

# SQLite cache location (default: data/cache/cache.db)
WEATHER_RISK_CACHE_PATH=data/cache/cache.db

# Cache TTLs in seconds
WEATHER_RISK_TTL_HISTORICAL_SECONDS=2592000
WEATHER_RISK_TTL_RECENT_SECONDS=86400
WEATHER_RISK_TTL_NRI_SECONDS=604800

# HTTP
WEATHER_RISK_HTTP_TIMEOUT_SECONDS=30
WEATHER_RISK_HTTP_MAX_ATTEMPTS=3

LOG_LEVEL=INFO

# ---- Public demo protection (Phase 7). Limits <= 0 disable a check; counters are in memory.
# WEATHER_RISK_CHAT_LIMIT_PER_IP_MINUTE=10
# WEATHER_RISK_CHAT_LIMIT_PER_IP_HOUR=60
# WEATHER_RISK_CHAT_LIMIT_PER_SESSION_HOUR=40
# WEATHER_RISK_CHAT_DAILY_LIMIT=300
# WEATHER_RISK_CHAT_MAX_WAITING=4            # AI questions queued behind the one running
# WEATHER_RISK_CHAT_QUEUE_TIMEOUT_SECONDS=30
# WEATHER_RISK_CHAT_DEADLINE_SECONDS=60      # overall budget per chat turn
# WEATHER_RISK_TRUSTED_PROXY_HOPS=0          # 1 behind Render/Railway
# WEATHER_RISK_DEMO_USERNAME=moveo
# WEATHER_RISK_DEMO_PASSWORD=                # set to require a shared password (HTTP Basic)
# WEATHER_RISK_SERVE_FRONTEND=true           # serve web/dist from FastAPI when it exists
